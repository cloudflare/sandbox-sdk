{
  "name": "sandbox-process-workspace-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  // Files resolves native Linux errno names through node:os.
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "SANDBOX",
        "class_name": "ProcessSandbox",
      },
    ],
  },
  "containers": [
    {
      "class_name": "ProcessSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": {
          "dockerfile": "./Dockerfile",
        },
      },
    },
  ],
  "exports": {
    "ProcessSandbox": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
}
