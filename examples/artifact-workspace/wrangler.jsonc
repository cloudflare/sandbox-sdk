{
  "name": "sandbox-artifact-workspace-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  // Files resolves native Linux errno names through node:os.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "S3_ENDPOINT": "https://s3.us-east-1.amazonaws.com",
    "S3_REGION": "us-east-1",
    "S3_BUCKET": "replace-with-your-artifact-bucket",
  },
  "secrets": {
    "required": ["S3_ACCESS_KEY_ID", "S3_SECRET_ACCESS_KEY"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SANDBOX",
        "class_name": "ArtifactSandbox",
      },
    ],
  },
  "containers": [
    {
      "class_name": "ArtifactSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": {
          "dockerfile": "./Dockerfile",
        },
      },
    },
  ],
  "exports": {
    "ArtifactSandbox": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
}
