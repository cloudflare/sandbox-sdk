{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devin-outpost",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  // Each run polls Devin every DEVIN_RECONCILE_INTERVAL_MS until the next run.
  "triggers": {
    "crons": ["* * * * *"],
  },
  "vars": {
    // Set this to the ID of the outpost you created in Devin.
    "DEVIN_OUTPOST_ID": "",
    "DEVIN_API_URL": "https://api.devin.ai/opbeta",
    "WORKER_ID_PREFIX": "cf-outpost",
    "DEVIN_RECONCILE_INTERVAL_MS": "10000",
  },
  "durable_objects": {
    "bindings": [{ "name": "DEVIN_SESSION", "class_name": "DevinSession" }],
  },
  "containers": [
    {
      "class_name": "DevinSession",
      "scheduling_policy": "durable_object",
      "images": {
        "devin": { "dockerfile": "./Dockerfile" },
      },
    },
  ],
  "exports": {
    "DevinSession": { "type": "durable-object", "storage": "sqlite" },
  },
  "observability": {
    "enabled": true,
  },
}
