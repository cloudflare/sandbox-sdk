{
  "name": "sandbox-sdk",
  "private": true,
  "description": "Application-owned sandbox patterns and workspace file operations for Cloudflare Containers",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack && npm run shim:build",
    "check": "vp check && npm run knip && npm run shim:check",
    "example:deploy": "npm run example:workspace:deploy",
    "example:types": "npm run example:workspace:types",
    "example:workspace:deploy": "npm run shim:build && npx --yes https://pkg.pr.new/wrangler@96d2d37d18f1e6742148d7d52d73dafe32aa97c3 deploy --config examples/workspace/wrangler.jsonc",
    "example:workspace:types": "npx --yes https://pkg.pr.new/wrangler@96d2d37d18f1e6742148d7d52d73dafe32aa97c3 types examples/workspace/worker-configuration.d.ts --config examples/workspace/wrangler.jsonc --include-runtime=false",
    "example:checkpoint-workspace:deploy": "npm run shim:build && npx --yes https://pkg.pr.new/wrangler@96d2d37d18f1e6742148d7d52d73dafe32aa97c3 deploy --config examples/checkpoint-workspace/wrangler.jsonc",
    "example:checkpoint-workspace:types": "npx --yes https://pkg.pr.new/wrangler@96d2d37d18f1e6742148d7d52d73dafe32aa97c3 types examples/checkpoint-workspace/worker-configuration.d.ts --config examples/checkpoint-workspace/wrangler.jsonc --include-runtime=false",
    "knip": "knip",
    "shim:build": "docker build --platform linux/amd64 --target image --tag sandbox-tools:local --file images/sandbox-tools/Dockerfile .",
    "shim:check": "docker build --platform linux/amd64 --target verify --file images/sandbox-tools/Dockerfile .",
    "test": "vp test --run --passWithNoTests && npm run shim:check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260902.1",
    "@types/node": "24.13.3",
    "knip": "6.34.0",
    "typescript": "6.0.3",
    "vite-plus": "0.3.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "npm@11.16.0"
}
