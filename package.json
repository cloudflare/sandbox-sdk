{
  "name": "sandbox-sdk",
  "private": true,
  "description": "Application-owned sandbox patterns and workspace file operations for Cloudflare Containers",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack && npm run shim:build",
    "check": "npm run check:ts && npm run shim:check",
    "check:ts": "vp pack && vp check && npm run knip",
    "examples:check-bundles": "node tools/example.ts check-bundles",
    "example:deploy": "npm run example:workspace:deploy",
    "example:types": "npm run example:workspace:types",
    "example:workspace:deploy": "node tools/example.ts deploy workspace",
    "example:workspace:types": "wrangler types examples/workspace/worker-configuration.d.ts --config examples/workspace/wrangler.jsonc --include-runtime=false",
    "example:artifact-workspace:deploy": "node tools/example.ts deploy artifact-workspace",
    "example:artifact-workspace:types": "wrangler types examples/artifact-workspace/worker-configuration.d.ts --config examples/artifact-workspace/wrangler.jsonc --include-runtime=false",
    "example:backup-workspace:deploy": "node tools/example.ts deploy backup-workspace",
    "example:backup-workspace:types": "wrangler types examples/backup-workspace/worker-configuration.d.ts --config examples/backup-workspace/wrangler.jsonc --include-runtime=false",
    "example:checkpoint-workspace:deploy": "node tools/example.ts deploy checkpoint-workspace",
    "example:checkpoint-workspace:types": "wrangler types examples/checkpoint-workspace/worker-configuration.d.ts --config examples/checkpoint-workspace/wrangler.jsonc --include-runtime=false",
    "example:outbound-workspace:deploy": "node tools/example.ts deploy outbound-workspace",
    "example:outbound-workspace:types": "wrangler types examples/outbound-workspace/worker-configuration.d.ts --config examples/outbound-workspace/wrangler.jsonc --include-runtime=false",
    "example:preview-workspace:deploy": "node tools/example.ts deploy preview-workspace",
    "example:preview-workspace:types": "wrangler types examples/preview-workspace/worker-configuration.d.ts --config examples/preview-workspace/wrangler.jsonc --include-runtime=false",
    "example:process-workspace:deploy": "node tools/example.ts deploy process-workspace",
    "example:process-workspace:types": "wrangler types examples/process-workspace/worker-configuration.d.ts --config examples/process-workspace/wrangler.jsonc --include-runtime=false",
    "example:share-workspace:deploy": "node tools/example.ts deploy share-workspace",
    "example:share-workspace:types": "wrangler types examples/share-workspace/worker-configuration.d.ts --config examples/share-workspace/wrangler.jsonc --include-runtime=false",
    "example:terminal-workspace:deploy": "node tools/example.ts deploy terminal-workspace",
    "example:terminal-workspace:types": "wrangler types examples/terminal-workspace/worker-configuration.d.ts --config examples/terminal-workspace/wrangler.jsonc --include-runtime=false",
    "example:coding-agents:pi:deploy": "node tools/example.ts deploy coding-agents/pi",
    "example:coding-agents:pi:types": "wrangler types examples/coding-agents/pi/worker-configuration.d.ts --config examples/coding-agents/pi/wrangler.jsonc --include-runtime=false",
    "example:coding-agents:claude-code:deploy": "node tools/example.ts deploy coding-agents/claude-code",
    "example:coding-agents:claude-code:types": "wrangler types examples/coding-agents/claude-code/worker-configuration.d.ts --config examples/coding-agents/claude-code/wrangler.jsonc --include-runtime=false",
    "example:coding-agents:codex:deploy": "node tools/example.ts deploy coding-agents/codex",
    "example:coding-agents:codex:types": "wrangler types examples/coding-agents/codex/worker-configuration.d.ts --config examples/coding-agents/codex/wrangler.jsonc --include-runtime=false",
    "example:coding-agents:opencode:deploy": "node tools/example.ts deploy coding-agents/opencode",
    "example:coding-agents:opencode:types": "wrangler types examples/coding-agents/opencode/worker-configuration.d.ts --config examples/coding-agents/opencode/wrangler.jsonc --include-runtime=false",
    "knip": "knip",
    "shim:build": "docker build --platform linux/amd64 ${SANDBOX_EXTRA_CA:+--secret id=extra_ca,src=$SANDBOX_EXTRA_CA} --target image --tag sandbox-tools:local --file images/sandbox-tools/Dockerfile .",
    "shim:check": "docker build --platform linux/amd64 ${SANDBOX_EXTRA_CA:+--secret id=extra_ca,src=$SANDBOX_EXTRA_CA} --target verify --file images/sandbox-tools/Dockerfile .",
    "test": "npm run test:unit && npm run shim:check",
    "test:unit": "vp test --run --passWithNoTests",
    "test:package": "vp pack && vp test --run packages/sandbox/tests/packed-api.test.ts && npm pack --workspace packages/sandbox --dry-run",
    "test:release": "npm test && npm run test:package && npm run test:shim-mounts && npm run test:s3-e2e && npm run test:s3-lifecycle",
    "test:shim-mounts": "docker build --platform linux/amd64 ${SANDBOX_EXTRA_CA:+--secret id=extra_ca,src=$SANDBOX_EXTRA_CA} --target mounts --tag sandbox-tools-mounts-test --file images/sandbox-tools/Dockerfile . && docker run --rm --privileged --platform linux/amd64 sandbox-tools-mounts-test; status=$?; docker image rm sandbox-tools-mounts-test >/dev/null 2>&1; exit $status",
    "test:s3-e2e": "SANDBOX_S3_E2E=1 vp test --run packages/sandbox/tests/s3-gateway.integration.test.ts",
    "test:s3-lifecycle": "SANDBOX_S3_LIFECYCLE=1 vp test --run packages/sandbox/tests/s3-mount.integration.test.ts",
    "test:s3-native-local": "vp pack && SANDBOX_S3_NATIVE_LOCAL=1 vp test --run packages/sandbox/tests/s3-native-local.integration.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@types/node": "24.13.3",
    "knip": "6.34.0",
    "typescript": "6.0.3",
    "vite-plus": "0.3.3",
    "wrangler": "4.148.0",
    "zod": "4.5.4"
  },
  "overrides": {
    "wrangler": "$wrangler"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "npm@11.16.0"
}
